# ==============================================================================
# ElevenLabs AI Voice Configuration for Kirana Change
# ==============================================================================
# Add your secret ElevenLabs API key here. Keep this file private!
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ------------------------------------------------------------------------------
# Models Strategy
# ------------------------------------------------------------------------------
# Recommended: eleven_multilingual_v2 for natural human warmth and rich expressiveness.
# Alternative: eleven_turbo_v2_5 for ultra-low latency.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ------------------------------------------------------------------------------
# Voice Settings (Tested for natural human conversational English)
# ------------------------------------------------------------------------------
# Stability: 0.0 - 1.0 (0.40 provides expressive, natural conversational tone)
ELEVENLABS_STABILITY=0.40

# Similarity Boost: 0.0 - 1.0 (0.75 maintains consistent voice identity)
ELEVENLABS_SIMILARITY_BOOST=0.75

# Style Exaggeration: 0.0 - 1.0 (0.20 adds emotional inflection)
ELEVENLABS_STYLE=0.20

# Speech Speed: 0.7 - 1.2 (1.00 is natural human pace)
ELEVENLABS_SPEED=1.00

# Speaker Boost: true / false (enhances clarity and presence)
ELEVENLABS_SPEAKER_BOOST=true

# ------------------------------------------------------------------------------
# Three Distinct Voices (Universal ElevenLabs Pre-made Voice IDs)
# ------------------------------------------------------------------------------
# 1. Boy Voice: Used by ALL male customers (Mr. Sharma, Rohan, Raju)
ELEVENLABS_BOY_VOICE_ID=ErXwobaYiN019PkySvjV

# 2. Girl Voice: Used by ALL female customers (Mrs. Priya, Meera & Anu, Grandma)
ELEVENLABS_GIRL_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# 3. Shopkeeper Voice: Used exclusively by the shopkeeper (George)
ELEVENLABS_SHOPKEEPER_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
